# AUTO_THUMBNAIL=true
# Time zone of the date drawn on the thumbnail
# TZ=Asia/Tokyo
# Rename the database properties if yours differ:
# PROP_PUBLISH=公開
# PROP_SLUG=スラッグ
# PROP_EXCERPT=抜粋
# PROP_CATEGORY=カテゴリ
# PROP_TAGS=タグ
# PROP_FEATURED_IMAGE=アイキャッチ
# PROP_EMDASH_URL=EmDash URL
# PROP_SENT_AT=送信日時

